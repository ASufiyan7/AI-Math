{
  "builds": [
    {
      "src": "back/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "front/package.json",
      "use": "@vercel/static-build",
      "config": {
        "installCommand": "npm install --include=dev",
        "buildCommand": "npm run build",
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "back/main.py" },
    { "src": "/(.*)", "dest": "front/dist/index.html" }
  ]
}
