{
  "version": 2,
  "builds": [
    {
      "src": "back/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "front/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/calculate",
      "dest": "/back/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/front/index.html"
    }
  ]
}